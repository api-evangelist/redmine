{
  "opencollection": "1.0.0",
  "info": {
    "name": "Redmine REST Attachments Custom Fields.json API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Redmine-API-Key",
      "value": "{{X-Redmine-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Fields.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List custom fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{redmine_host}/custom_fields.json"
          },
          "docs": "List custom fields"
        }
      ]
    }
  ],
  "bundled": true
}