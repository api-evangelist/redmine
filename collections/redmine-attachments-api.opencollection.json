{
  "opencollection": "1.0.0",
  "info": {
    "name": "Redmine REST Attachments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Redmine-API-Key",
      "value": "{{X-Redmine-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attachments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show attachment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{redmine_host}/attachments/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show attachment"
        },
        {
          "info": {
            "name": "Delete attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{redmine_host}/attachments/:id.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete attachment"
        }
      ]
    }
  ],
  "bundled": true
}