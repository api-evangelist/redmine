{
  "opencollection": "1.0.0",
  "info": {
    "name": "Redmine REST Attachments Groups.json API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Redmine-API-Key",
      "value": "{{X-Redmine-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{redmine_host}/groups.json"
          },
          "docs": "List groups"
        },
        {
          "info": {
            "name": "Create group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{redmine_host}/groups.json",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create group"
        }
      ]
    }
  ],
  "bundled": true
}