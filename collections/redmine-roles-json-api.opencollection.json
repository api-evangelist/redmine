{
  "opencollection": "1.0.0",
  "info": {
    "name": "Redmine REST Attachments Roles.json API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Redmine-API-Key",
      "value": "{{X-Redmine-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{redmine_host}/roles.json"
          },
          "docs": "List roles"
        }
      ]
    }
  ],
  "bundled": true
}